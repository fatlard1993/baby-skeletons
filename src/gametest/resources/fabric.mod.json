{
	"schemaVersion": 1,
	"id": "baby-skeletons-gametest",
	"version": "1.0.0",
	"name": "Baby Skeletons tests",
	"description": "Loads the mod, joins a world, and checks babies are born and sized.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
