			"justfatlard.baby_skeletons.Main"
		]
	},
	"mixins": [
		"baby-skeletons-justfatlard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"minecraft": "${minecraftDependency}",
